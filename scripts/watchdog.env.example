# FrankenLLM watchdog settings. Copy to /etc/frankenllm/watchdog.env (mode 0600,
# root only). A channel is on when its variables are set; leave the rest empty.
# Prefer Doppler for the secrets: set WATCHDOG_USE_DOPPLER=true plus DOPPLER_TOKEN
# and keep the channel values in the Doppler config instead of this file.

# What alerts call this machine (never put a hostname here)
#WATCHDOG_LABEL=FrankenLLM

# Discord: a channel webhook URL
#DISCORD_WEBHOOK_URL=

# ntfy: the full topic URL, plus a token if the topic needs one
#NTFY_URL=https://ntfy.example.com/frankenllm
#NTFY_TOKEN=

# Matrix: homeserver URL, an access token, and the room ID (!abc:example.com)
#MATRIX_HOMESERVER=https://matrix.example.com
#MATRIX_ACCESS_TOKEN=
#MATRIX_ROOM_ID=

# Email over SMTP (no local mail agent needed). SMTP_SECURITY: starttls (587), ssl (465), none
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURITY=starttls
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=frankenllm@example.com
#EMAIL_TO=you@example.com

# Tuning (defaults shown)
#WATCHDOG_REPEAT_HOURS=24
#WATCHDOG_REBOOT_GRACE_HOURS=72
#WATCHDOG_PORTS="11434 11435"
#WATCHDOG_USE_DOPPLER=false
