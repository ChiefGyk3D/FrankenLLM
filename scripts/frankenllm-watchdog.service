[Unit]
Description=FrankenLLM watchdog (GPU, driver and Ollama health alerts)
After=network-online.target

[Service]
Type=oneshot
# Needs no root: nvidia-smi, /proc and localhost HTTP are all readable by anyone.
# Run unprivileged from a root-owned directory so nobody who can write the
# FrankenLLM checkout can ever get this to run their code as root.
ExecStart=/usr/local/lib/frankenllm/watchdog.sh
# The settings file is handed over as a credential (read as root, readable only
# by this unit) and parsed by watchdog-env.sh as data, never as shell code.
LoadCredential=watchdog.env:/etc/frankenllm/watchdog.env
Environment=HOME=/var/lib/frankenllm-watchdog
DynamicUser=yes
StateDirectory=frankenllm-watchdog
StateDirectoryMode=0750
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# Resource ceilings so a hostile or broken endpoint cannot starve the GPU box.
# No PrivateDevices: nvidia-smi needs the NVIDIA device nodes.
MemoryMax=128M
CPUQuota=50%
TimeoutStartSec=120
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
