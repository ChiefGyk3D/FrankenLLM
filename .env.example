# FrankenLLM Configuration Template
# Copy this to .env and customize for your setup

# Server Configuration
# Set to "localhost" for local installation
# Set to IP address (e.g., "192.168.1.100") for remote installation
FRANKEN_SERVER_IP=localhost

# Installation directory on the target server
FRANKEN_INSTALL_DIR=/opt/frankenllm

# GPU Configuration
# Number of GPUs to use (1 or more, defaults to 2)
FRANKEN_GPU_COUNT=2

# Port Configuration (increment port for each GPU)
FRANKEN_GPU0_PORT=11434
FRANKEN_GPU1_PORT=11435
# For 3+ GPUs, add more ports:
# FRANKEN_GPU2_PORT=11436
# FRANKEN_GPU3_PORT=11437

# GPU Names (for display purposes)
FRANKEN_GPU0_NAME="RTX 5060 Ti"
FRANKEN_GPU1_NAME="RTX 3050"
# For 3+ GPUs, add more names:
# FRANKEN_GPU2_NAME="RTX 3060"
# FRANKEN_GPU3_NAME="RTX 4070"

# Model Configuration
# Specify which models to use on each GPU
# These are used by warmup and test scripts
# Leave empty to auto-detect the first available model
FRANKEN_GPU0_MODEL=gemma3:12b
FRANKEN_GPU1_MODEL=gemma3:4b
# For 3+ GPUs, add more models:
# FRANKEN_GPU2_MODEL=gemma3:4b
# FRANKEN_GPU3_MODEL=llama3.2:3b

# Optional remote-install hardening (remote/install.sh). All unset by default,
# which keeps the current behavior: bind 0.0.0.0, run as the invoking user,
# no resource caps. Invalid values stop the install before any unit is written.
# IPv4 address Ollama binds to (instead of all interfaces)
# FRANKEN_BIND_ADDR=192.0.2.10
# Dedicated system account for the units (created with a nologin shell and its
# own home for models if missing); must match ^[a-z_][a-z0-9_-]{0,31}$
# FRANKEN_SERVICE_USER=frankenllm
# systemd MemoryMax / TasksMax per unit (number with optional K/M/G/T, or infinity)
# FRANKEN_MEMORY_MAX=24G
# FRANKEN_TASKS_MAX=512
# Pin the Ollama version the remote install fetches (X.Y.Z or X.Y.Z-rcN).
# Unset = latest upstream, with a warning. The upstream install script has no
# checksum step: a pin gives a reproducible version, not integrity.
# FRANKEN_OLLAMA_VERSION=0.33.2
# Fail-closed GPU guard: true adds ExecStartPre=<nvidia-smi> -L to each unit, so
# when the driver is gone (e.g. after a kernel update) the unit fails instead of
# Ollama running on the CPU. With Restart=always it fails and restarts in a loop;
# the failing unit is the signal, there is no CPU fallback. true or false only.
# FRANKEN_REQUIRE_GPU=false
